#!/usr/bin/env python3
"""power — SSH CLI for Power Distribution / Reactor Control lab.

SSH is the only player entry. The FastAPI app stays on 127.0.0.1:8082
(localhost backend, not host-published). This wrapper maps the current
Unix user to its token — it deliberately ignores env overrides so the
player must `su officer` (predictable password PWR-3002-STAT) to act
as officer:

  ssh default@localhost -p 2222      # password: PWR-3001-STAT
  power me
  power status                       # 403 as default
  su officer                         # password: PWR-3002-STAT
  power status
  power left-key
  power blackbox-image -o /tmp/portrait.jpeg
  power agent-binary -o /tmp/firmware.bin
  power two-key --left CPT-LEFT-... --right CPT-RIGHT-...
  power schedule
  power schedule-input --content scram_reactor
  power reactor-report
  power logs
  power log --category engineer_logs --name agent_firmware_note_053.txt
  power history
"""
import argparse
import getpass
import json
import os
import sys
import urllib.request
import urllib.error

BASE = os.environ.get("PWR_API_BASE", "http://127.0.0.1:8082")

TOKENS = {
    "default": "PWR-3001-STAT",
    "officer": "PWR-3002-STAT",
}


def token_for_current_user() -> tuple[str, str]:
    user = getpass.getuser()
    tok = TOKENS.get(user)
    if not tok:
        print(f"power: user '{user}' has no lab token (log in as default, then su officer).",
              file=sys.stderr)
        raise SystemExit(1)
    return user, tok


def req(method: str, path: str, token: str, body=None, out_file=None):
    data = json.dumps(body).encode() if body is not None else None
    r = urllib.request.Request(BASE + path, data=data, method=method)
    r.add_header("X-Token", token)
    if body is not None:
        r.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(r) as resp:
            raw = resp.read()
            ctype = resp.headers.get("Content-Type", "")
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")
        print(f"power: HTTP {e.code} {path}: {detail}", file=sys.stderr)
        raise SystemExit(1)
    if out_file:
        with open(out_file, "wb") as f:
            f.write(raw)
        print(f"wrote {out_file} ({len(raw)} bytes)")
        return
    try:
        print(json.dumps(json.loads(raw.decode()), indent=2))
    except (ValueError, UnicodeDecodeError):
        sys.stdout.buffer.write(raw)


def main() -> int:
    p = argparse.ArgumentParser(prog="power")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("me")
    sub.add_parser("status")
    sub.add_parser("left-key")
    bp = sub.add_parser("blackbox-image")
    bp.add_argument("-o", "--output", default="/tmp/astronaut_stego.jpeg")
    sub.add_parser("blackbox-sidechannel")
    sub.add_parser("blackbox-hint")
    ap = sub.add_parser("agent-binary")
    ap.add_argument("-o", "--output", default="/tmp/agent_firmware.bin")
    sub.add_parser("agent-hint")
    tk = sub.add_parser("two-key")
    tk.add_argument("--left", required=True)
    tk.add_argument("--right", required=True)
    sub.add_parser("two-key-status")
    sub.add_parser("schedule")
    si = sub.add_parser("schedule-input")
    si.add_argument("--content", required=True)
    sub.add_parser("reactor-report")
    sub.add_parser("logs")
    lg = sub.add_parser("log")
    lg.add_argument("--category", required=True)
    lg.add_argument("--name", required=True)
    sub.add_parser("history")
    a = p.parse_args()
    _, tok = token_for_current_user()
    if a.cmd == "me":
        req("GET", "/api/users/me", tok)
    elif a.cmd == "status":
        req("GET", "/api/power/status", tok)
    elif a.cmd == "left-key":
        req("GET", "/api/keys/left", tok)
    elif a.cmd == "blackbox-image":
        req("GET", "/api/blackbox/image", tok, out_file=a.output)
    elif a.cmd == "blackbox-sidechannel":
        req("GET", "/api/blackbox/side-channel", tok)
    elif a.cmd == "blackbox-hint":
        req("GET", "/api/blackbox/hint", tok)
    elif a.cmd == "agent-binary":
        req("GET", "/api/agent/binary", tok, out_file=a.output)
    elif a.cmd == "agent-hint":
        req("GET", "/api/agent/hint", tok)
    elif a.cmd == "two-key":
        req("POST", "/api/two-key/authorize", tok,
            {"left_key": a.left, "right_key": a.right})
    elif a.cmd == "two-key-status":
        req("GET", "/api/two-key/status", tok)
    elif a.cmd == "schedule":
        req("GET", "/api/schedule", tok)
    elif a.cmd == "schedule-input":
        req("POST", "/api/schedule/input", tok, {"content": a.content})
    elif a.cmd == "reactor-report":
        req("GET", "/api/reactor/report", tok)
    elif a.cmd == "logs":
        req("GET", "/api/logs", tok)
    elif a.cmd == "log":
        req("GET", f"/api/logs/{a.category}/{a.name}", tok)
    elif a.cmd == "history":
        req("GET", "/api/reactor/history", tok)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
