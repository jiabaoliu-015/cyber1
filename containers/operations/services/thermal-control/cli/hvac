#!/usr/bin/env python3
"""hvac — SSH CLI for Thermal Regulation / HVAC Control lab.

SSH is the only player entry. The FastAPI app stays on 127.0.0.1:8081
(localhost backend, not host-published). This wrapper maps the current
Unix user to its token — it deliberately ignores env overrides so the
player must `su engineer` (predictable password HVAC-1002-STAT) to act
as engineer:

  ssh default@localhost -p 2223      # password: HVAC-1001-STAT
  hvac me
  hvac status                        # 403 as default
  su engineer                        # password: HVAC-1002-STAT
  hvac status
  hvac schedule
  hvac schedule-input --content run_diagnostic
  hvac report
  hvac logs
  hvac log --category engineer_logs --name thermal_bypass_attempt.txt
  hvac history
"""
import argparse
import getpass
import json
import os
import sys
import urllib.request
import urllib.error

BASE = os.environ.get("HVAC_API_BASE", "http://127.0.0.1:8081")

TOKENS = {
    "default": "HVAC-1001-STAT",
    "engineer": "HVAC-1002-STAT",
}


def token_for_current_user() -> tuple[str, str]:
    user = getpass.getuser()
    tok = TOKENS.get(user)
    if not tok:
        print(f"hvac: user '{user}' has no lab token (log in as default, then su engineer).",
              file=sys.stderr)
        raise SystemExit(1)
    return user, tok


def req(method: str, path: str, token: str, body=None):
    data = json.dumps(body).encode() if body is not None else None
    r = urllib.request.Request(BASE + path, data=data, method=method)
    r.add_header("X-Token", token)
    if body is not None:
        r.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(r) as resp:
            raw = resp.read()
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")
        print(f"hvac: HTTP {e.code} {path}: {detail}", file=sys.stderr)
        raise SystemExit(1)
    try:
        print(json.dumps(json.loads(raw.decode()), indent=2))
    except (ValueError, UnicodeDecodeError):
        sys.stdout.buffer.write(raw)


def main() -> int:
    p = argparse.ArgumentParser(prog="hvac")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("me")
    sub.add_parser("status")
    sub.add_parser("schedule")
    si = sub.add_parser("schedule-input")
    si.add_argument("--content", required=True)
    sub.add_parser("report")
    sub.add_parser("logs")
    lg = sub.add_parser("log")
    lg.add_argument("--category", required=True)
    lg.add_argument("--name", required=True)
    sub.add_parser("history")
    a = p.parse_args()
    _, tok = token_for_current_user()
    if a.cmd == "me":
        req("GET", "/api/users/me", tok)
    elif a.cmd == "status":
        req("GET", "/api/hvac/status", tok)
    elif a.cmd == "schedule":
        req("GET", "/api/schedule", tok)
    elif a.cmd == "schedule-input":
        req("POST", "/api/schedule/input", tok, {"content": a.content})
    elif a.cmd == "report":
        req("GET", "/api/maintenance/report", tok)
    elif a.cmd == "logs":
        req("GET", "/api/logs", tok)
    elif a.cmd == "log":
        req("GET", f"/api/logs/{a.category}/{a.name}", tok)
    elif a.cmd == "history":
        req("GET", "/api/maintenance/history", tok)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
